# ==============================================================================
# EchoMind Configuration Template
# Copy this file to .env for local runtime configuration overrides.
# ==============================================================================

# Application Metadata
APP_NAME=EchoMind
APP_ENV=development
DEBUG=true

# Logging Configuration
LOG_LEVEL=INFO
LOG_FILE_PATH=data/logs/echomind.log
LOG_ROTATION=10 MB
LOG_RETENTION=14 days
LOG_JSON_FORMAT=false

# Audio Stream Engine Settings (Future Phase Configuration)
AUDIO_SAMPLE_RATE=16000
AUDIO_CHANNELS=1
AUDIO_CHUNK_DURATION_SEC=5

# Multilingual STT Settings (Future Phase Configuration)
DEFAULT_SOURCE_LANGUAGES=["mr", "hi", "en"]
TARGET_LANGUAGE=en

# Keyword Trigger Settings
DEFAULT_ALERT_KEYWORDS=["Prayag", "EchoMind", "Action Item"]
